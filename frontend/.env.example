# Base path the browser uses to reach the API. The production web image builds with
# /api/v1 and a same-origin nginx proxy; `npm run dev` proxies the same path to
# http://localhost:8080. No API secret is ever compiled into the bundle.
VITE_API_BASE_URL=/api/v1

# Shown under the wordmark in the sidebar.
VITE_ENVIRONMENT_LABEL=Demo environment
