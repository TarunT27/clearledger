# Copy to .env, replace every placeholder, and keep .env out of version control.
POSTGRES_DB=clearledger
POSTGRES_USER=clearledger
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
WEB_PORT=8088
RECONCILIATION_FIXED_DELAY_MS=30000

# Pause or run the background reconciliation worker. The demo leaves it paused so the
# exception queue stays open long enough to repair a case by hand.
RECONCILIATION_ENABLED=false

# Seed two months of payment history the first time the database comes up empty.
DEMO_SEED_HISTORY=true
