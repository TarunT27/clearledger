# syntax=docker/dockerfile:1.7

FROM eclipse-temurin:25-jdk-jammy AS build
WORKDIR /workspace

COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN chmod +x mvnw \
    && --mount=type=cache,target=/root/.m2 ./mvnw -B -ntp dependency:go-offline

COPY src/ src/
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -ntp package -DskipTests \
    && java -Djarmode=tools -jar target/*.jar extract --layers --destination /workspace/extracted

FROM eclipse-temurin:25-jre-jammy AS runtime
RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 clearledger \
    && useradd --system --uid 10001 --gid clearledger --create-home clearledger
WORKDIR /app

COPY --from=build --chown=clearledger:clearledger /workspace/extracted/dependencies/ ./
COPY --from=build --chown=clearledger:clearledger /workspace/extracted/spring-boot-loader/ ./
COPY --from=build --chown=clearledger:clearledger /workspace/extracted/snapshot-dependencies/ ./
COPY --from=build --chown=clearledger:clearledger /workspace/extracted/application/ ./

USER 10001:10001
EXPOSE 8080

ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError" \
    SERVER_SHUTDOWN="graceful"

ENTRYPOINT ["java", "-jar", "application.jar"]
